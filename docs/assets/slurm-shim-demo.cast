{"version":3,"term":{"cols":80,"rows":24},"timestamp":1789363710,"idle_time_limit":1.5,"command":"docker exec -t -u gridware -w /home/gridware ocs-master bash -l demo-cast.sh","env":{"SHELL":"/bin/bash"}}
[0.144, "o", "\u001b[0;90m# A stock SLURM batch script. Nothing in it knows about Grid Engine.\u001b[0m\r\r\n"]
[1.206, "o", "\u001b[1;32m$\u001b[0m \u001b[1mcat train.sh\u001b[0m\r\r\n"]
[0.610, "o", "#!/bin/bash\r\r\n#SBATCH --job-name=train\r\r\n#SBATCH --partition=batch\r\r\n#SBATCH --nodes=3\r\r\n#SBATCH --ntasks-per-node=2\r\r\n#SBATCH --output=slurm-%j.out\r\r\n\r\r\necho \"[alloc] nodes=$SLURM_NNODES tasks=$SLURM_NTASKS\"\r\r\necho \"[alloc] nodelist=$SLURM_JOB_NODELIST\"\r\r\necho \"[alloc] rendezvous=$MASTER_ADDR:$MASTER_PORT\"\r\r\nsrun bash -c 'echo \"  rank $SLURM_PROCID/$SLURM_NTASKS on $(hostname)\"'\r\r\n"]
[0.000, "o", "\r\r\n"]
[1.206, "o", "\u001b[0;90m# But this cluster runs Open Cluster Scheduler. There is no slurmd anywhere.\u001b[0m\r\r\n"]
[1.207, "o", "\u001b[1;32m$\u001b[0m \u001b[1mqhost | awk '/^-/{next} {printf \"%-14s %-9s %4s %6s\\n\",$1,$2,$3,$7}'\u001b[0m\r\r\n"]
[0.622, "o", "HOSTNAME       ARCH      NCPU   LOAD\r\r\nglobal         -            -      -\r\r\nocs-master     lx-arm64    14   0.59\r\r\nocs-worker1    lx-arm64    14   0.59\r\r\nocs-worker2    lx-arm64    14   0.59\r\r\n"]
[0.000, "o", "\r\r\n"]
[1.207, "o", "\u001b[0;90m# Submit it the way you would on SLURM.\u001b[0m\r\r\n"]
[1.205, "o", "\u001b[1;32m$\u001b[0m \u001b[1msbatch train.sh\u001b[0m\r\r\n"]
[0.634, "o", "Submitted batch job 2251\r\r\n\r\r\n"]
[4.211, "o", "\u001b[0;90m# squeue sees it, because squeue is the shim reading qstat.\u001b[0m\r\r\n"]
[1.204, "o", "\u001b[1;32m$\u001b[0m \u001b[1msqueue -o '%i %P %j %u %t'\u001b[0m\r\r\n"]
[0.625, "o", "JOBID PARTITION NAME USER ST\r\r\n2251  train gridware PD\r\r\n"]
[0.000, "o", "\r\r\n"]
[0.518, "x", "0"]
