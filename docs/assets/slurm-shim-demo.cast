{"version":3,"term":{"cols":80,"rows":24},"timestamp":1789316641,"idle_time_limit":1.5,"command":"docker exec -t -u gridware -w /home/gridware ocs-master bash -l demo-cast.sh","env":{"SHELL":"/bin/bash"}}
[0.138, "o", "\u001b[0;90m# A stock SLURM batch script. Nothing in it knows about Grid Engine.\u001b[0m\r\r\n"]
[1.204, "o", "\u001b[1;32m$\u001b[0m \u001b[1mcat train.sh\u001b[0m\r\r\n"]
[0.608, "o", "#!/bin/bash\r\r\n#SBATCH --job-name=train\r\r\n#SBATCH --partition=batch\r\r\n#SBATCH --nodes=3\r\r\n#SBATCH --ntasks-per-node=2\r\r\n#SBATCH --output=slurm-%j.out\r\r\n\r\r\necho \"[alloc] nodes=$SLURM_NNODES tasks=$SLURM_NTASKS\"\r\r\necho \"[alloc] nodelist=$SLURM_JOB_NODELIST\"\r\r\necho \"[alloc] rendezvous=$MASTER_ADDR:$MASTER_PORT\"\r\r\nsrun bash -c 'echo \"  rank $SLURM_PROCID/$SLURM_NTASKS on $(hostname)\"'\r\r\n\r\r\n"]
[1.203, "o", "\u001b[0;90m# But this cluster runs Open Cluster Scheduler. There is no slurmd anywhere.\u001b[0m\r\r\n"]
[1.206, "o", "\u001b[1;32m$\u001b[0m \u001b[1mqhost | awk '/^-/{next} {printf \"%-14s %-9s %4s %6s\\n\",$1,$2,$3,$7}'\u001b[0m\r\r\n"]
[0.617, "o", "HOSTNAME       ARCH      NCPU   LOAD\r\r\nglobal         -            -      -\r\r\nocs-master     lx-arm64    14   0.63\r\r\nocs-worker1    lx-arm64    14   0.66\r\r\nocs-worker2    lx-arm64    14   0.64\r\r\n"]
[0.005, "o", "\r\r\n"]
[1.198, "o", "\u001b[0;90m# Submit it the way you would on SLURM.\u001b[0m\r\r\n"]
[1.202, "o", "\u001b[1;32m$\u001b[0m \u001b[1msbatch train.sh\u001b[0m\r\r\n"]
[0.616, "o", "Submitted batch job 2250\r\r\n\r\r\n"]
[4.211, "o", "\u001b[0;90m# squeue sees it, because squeue is the shim reading qstat.\u001b[0m\r\r\n"]
[1.207, "o", "\u001b[1;32m$\u001b[0m \u001b[1msqueue -o '%i %P %j %u %t'\u001b[0m\r\r\n"]
[0.620, "o", "JOBID PARTITION NAME USER ST\r\r\n2250 all.q train gridware R\r\r\n"]
[0.001, "o", "\r\r\n"]
[1.206, "o", "\u001b[0;90m# waiting for it to finish...\u001b[0m\r\r\n"]
[1.013, "o", "\u001b[0;90m# The SLURM_* environment was fabricated by the PE hook, and srun fanned six\u001b[0m\r\r\n"]
[1.208, "o", "\u001b[0;90m# ranks across three nodes over qrsh -inherit tight integration.\u001b[0m\r\r\n"]
[1.203, "o", "\u001b[1;32m$\u001b[0m \u001b[1mcat slurm-2250.out\u001b[0m\r\r\n"]
[0.608, "o", "[alloc] nodes=3 tasks=6\r\r\n[alloc] nodelist=ocs-worker[2,1],ocs-master\r\r\n[alloc] rendezvous=ocs-worker2:29750\r\r\n  rank 5/6 on ocs-master\r\r\n  rank 0/6 on ocs-worker2\r\r\n  rank 2/6 on ocs-worker1\r\r\n  rank 1/6 on ocs-worker2\r\r\n  rank 4/6 on ocs-master\r\r\n  rank 3/6 on ocs-worker1\r\r\n\r\r\n"]
[1.204, "o", "\u001b[0;90m# sacct reads the job back out of Grid Engine's accounting file.\u001b[0m\r\r\n"]
[1.204, "o", "\u001b[1;32m$\u001b[0m \u001b[1msacct -j 2250 --format=JobID,JobName,State,ExitCode,Elapsed\u001b[0m\r\r\n"]
[0.627, "o", "JobID JobName     State ExitCode  Elapsed\r\r\n----- ------- --------- -------- --------\r\r\n 2250   train COMPLETED      0:0 00:00:04\r\r\n"]
[0.003, "o", "\r\r\n"]
[1.202, "o", "\u001b[0;90m# One static binary. No SLURM installed, no daemons added.\u001b[0m\r\r\n"]
[1.206, "o", "\u001b[1;32m$\u001b[0m \u001b[1msbatch --version\u001b[0m\r\r\n"]
[0.612, "o", "slurm 24.05.0 (slurm-shim v0.4.0-1-g9f83896-dirty)\r\r\n\r\r\n"]
